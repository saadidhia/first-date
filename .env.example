# Copy to .env and fill in (never commit .env)
DOMAIN=example.com
POSTGRES_PASSWORD=change-me
# 32+ random chars, e.g. `openssl rand -hex 32`
SESSION_SECRET=
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=

# Local dev only (pnpm dev); docker compose builds this itself
DATABASE_URL=postgres://firstdate:change-me@localhost:5432/firstdate

# Flouci coin payments (optional). Get these from your Flouci merchant dashboard.
# If unset, the "buy coins" option is hidden (vouchers/admin top-up still work).
FLOUCI_PUBLIC_KEY=
FLOUCI_PRIVATE_KEY=
# Public base URL for Flouci return/webhook links; falls back to the request host.
# Set this in production, e.g. https://first-date.app
PUBLIC_BASE_URL=

# Rewarded ads ("watch an ad, get 50 coins"): your Google AdSense/H5 publisher id
# (ca-pub-...). If unset, the watch-ad button is hidden. Vite BUILD-time var — must be
# present when building (e.g. a docker build arg), not only at runtime.
VITE_ADSENSE_CLIENT=
